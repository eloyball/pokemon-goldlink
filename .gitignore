# Root ignore rules for the pokemon-hg monorepo.
# Subprojects keep their own rules: hg-engine/.gitignore (build outputs,
# generated sources, base ROM) and coop-relay/.gitignore (target/).

# --- Never commit: copyrighted ROMs, saves and savestates (any directory) ---
*.nds
*.srl
*.sav
*.dsv
*.ds[0-9]
*.dst
*.ml[0-9]
*.mln

# --- Emulator install (binaries, user config, installed CoopBridge.dll) ---
/BizHawk/
/emulators/
# Extra BizHawk instances (scripts/run_bizhawk.sh <name>): configs, saves, secrets
/instances/
# Probe output (dev/run_probe.sh)
/build/
# Dev tools (Lua probes, test runners) and the project docs (plans, risks, specs): a private
# repository of their own (eloyball/pokemon-goldlink-dev). docs is a local link to dev/docs.
/dev/
/docs

# --- Rust workspace build outputs (Cargo.toml at the root; the relay and launcher keep their own) ---
/target/

# --- coop-bridge build outputs ---
/coop-bridge/src/bin/
/coop-bridge/src/obj/

# --- coop-relay runtime data (campaign rosters; default --save-dir) ---
/campaigns/
/coop-relay/campaigns/

# --- Python ---
__pycache__/
*.pyc
.venv/
.local-tools/

# --- Editors / OS / tooling ---
.vscode/
.idea/
.cache/
.DS_Store
compile_commands.json
