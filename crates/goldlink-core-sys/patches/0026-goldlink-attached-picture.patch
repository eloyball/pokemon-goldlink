 void SoftRenderer::ClearBuffers(const GPU& gpu)
 {
+    UseAttached();
+    ClearPicture(gpu);
+    memset(AttColor, 0, sizeof(AttColor));
+    memset(AttTransDepth, 0xFF, sizeof(AttTransDepth));
+    std::fill(std::begin(AttK), std::end(AttK), 1.0f);
+    memset(AttB, 0, sizeof(AttB));
+    UseWorld();
+    ClearPicture(gpu);
+    std::fill(std::begin(LateK), std::end(LateK), 1.0f);
+    memset(LateB, 0, sizeof(LateB));
+    memset(LateDepth, 0xFF, sizeof(LateDepth));
+}
+
+void SoftRenderer::UseWorld() noexcept
