+// GoldLink (UC12): line y of the two pictures put together at the DS's pixels (the attached one
+// is drawn on the world's), what the 2D engine shows.
+void SoftRenderer::ComboLine(const GPU3D& gpu3d, s32 y)
+{
+    u32* out = &Combo[y * ScanlineWidth];
+    const u32 row = FirstPixelOffset + y * ScanlineWidth;
+    if (!AnyAttached)
+    {
+        memcpy(out, &MainColor[row], RenderWidth * 4);
+        return;
+    }
+    for (int x = 0; x < RenderWidth; x++)
+        out[x] = Composite(Rendered, x, y, x, y, 0, 0);
+}
