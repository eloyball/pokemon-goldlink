+    }
+    else
+    {
+        // The world's pixel on top; the attached picture's translucent pixels may be in front of
+        // it, or the attached picture between it and the pixel behind it.
+        const bool front = attIn && k < 1.0f && at < wd;
+        const bool lateOver = front && late && (p.LateDepth[wi] & 0xFFFFFF) < at;
+        const u32 top = lateOver ? p.LateEarly[wi] : p.WorldTop[wi];
+        u32 bottom = p.WorldBottom[wi];
+        if (attIn && k < 1.0f && at > wd && at < (p.WorldBottomDepth[wi] & 0xFFFFFF))
+            bottom = opaque ? p.AttTop[ai] : apply(p.AttK, p.AttB, ai, bottom);
+        out = finalPass(top, p.WorldTopAttr[wi], wd, bottom, false);
+        if (front && (p.WorldTopAttr[wi] & (1 << 22)))
+        {
+            // Over the world's own translucent pixels (another shadow): the darker of the
+            // attached picture's over the world before them and the world's, a channel each: the
+            // two shadows read as one, not one over the other (the user's choice).
+            const u32 under = apply(p.AttK, p.AttB, ai, finalPass(p.WorldOpaque[wi], p.WorldTopAttr[wi], wd, bottom, false));
+            u32 o = out & 0xFF000000u;
+            for (int ch = 0; ch < 3; ch++)
+                o |= std::min((under >> (8 * ch)) & 0x3F, (out >> (8 * ch)) & 0x3F) << (8 * ch);
+            out = o;
+        }
+        else if (front)
+        {
+            out = apply(p.AttK, p.AttB, ai, out);
+            if (lateOver)
+                out = apply(p.LateK, p.LateB, wi, out);
+        }
+    }
+    return out;
+}
