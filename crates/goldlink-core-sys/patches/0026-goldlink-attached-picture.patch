+u32 SoftRenderer::Composite(const Pictures& p, int wx, int wy, int ax, int ay, float dx, float dy)
+{
+    const int S = p.Stride;
+    auto mix = [](u32 top, u32 bottom, u32 a) -> u32 { // a: 0..32 of top
+        u32 r = ((top & 0x3F) * a + (bottom & 0x3F) * (32 - a)) >> 5;
+        u32 g = (((top >> 8) & 0x3F) * a + ((bottom >> 8) & 0x3F) * (32 - a)) >> 5;
+        u32 b = (((top >> 16) & 0x3F) * a + ((bottom >> 16) & 0x3F) * (32 - a)) >> 5;
+        return r | (g << 8) | (b << 16);
+    };
+    // k * c + b, a channel each (what a stack of translucent pixels does to what's behind it).
+    auto apply = [](const float* k, const float* b, int i, u32 c) -> u32 {
+        u32 o = 0;
+        for (int ch = 0; ch < 3; ch++)
+        {
+            const float v = k[i] * ((c >> (8 * ch)) & 0x3F) + b[i * 3 + ch];
+            o |= (u32)std::clamp((int)(v + 0.5f), 0, 63) << (8 * ch);
+        }
+        return o | (c & 0xFF000000u);
+    };
+    auto inAtt = [](int x, int y) { return x >= 0 && y >= 0 && x < RenderWidth && y < 192; };
+    const bool attIn = inAtt(ax, ay);
+    const int wi = wy * S + wx, ai = attIn ? ay * S + ax : 0;
+    const u32 wd = p.WorldTopDepth[wi] & 0xFFFFFF;
+    const float k = attIn ? p.AttK[ai] : 1.0f;
+    const bool opaque = attIn && k == 0.0f;
+    const u32 ad = opaque ? (p.AttTopDepth[ai] & 0xFFFFFF) : 0xFFFFFFFFu;
+    const u32 at = attIn && k < 1.0f ? std::min(ad, p.AttTransDepth[ai] & 0xFFFFFFu) : 0xFFFFFFFFu;
+    const bool late = p.LateK[wi] < 1.0f || p.LateB[wi * 3] || p.LateB[wi * 3 + 1] || p.LateB[wi * 3 + 2];
+    // The opaque pixel on top at the world's point (x, y), the attached picture's (qx, qy).
+    auto opaqueAt = [&](int x, int y, int qx, int qy, u32& id, u32& depth) {
+        id = (p.WorldTopAttr[y * S + x] >> 24) & 0x3F;
+        depth = p.WorldTopDepth[y * S + x] & 0xFFFFFF;
+        if (inAtt(qx, qy) && p.AttK[qy * S + qx] == 0.0f && (p.AttTopDepth[qy * S + qx] & 0xFFFFFF) < depth)
+        {
+            id = (p.AttAttr[qy * S + qx] >> 24) & 0x3F;
+            depth = p.AttTopDepth[qy * S + qx] & 0xFFFFFF;
+        }
+    };
+    // The DS's final pass on the top pixel (its colour, attributes and depth; the pixel behind
+    // it), its neighbours in its own picture's pixels.
+    auto finalPass = [&](u32 colour, u32 attr, u32 depth, u32 bottom, bool fromAtt) -> u32 {
+        if ((p.DispCnt & (1 << 5)) && (attr & 0xF))
+        {
+            const u32 id = (attr >> 24) & 0x3F;
