+}
+
+// GoldLink: master brightness and the 32-bit conversion, as DrawScanline does for a line.
+void SoftRenderer::FinishPixels(u32* px, int count)
+{
+    u32 masterBrightness = CurUnit->MasterBrightness;
+    u32 factor = masterBrightness & 0x1F;
+    if (factor > 16) factor = 16;
+    for (int i = 0; i < count; i++)
+    {
+        if ((masterBrightness >> 14) == 1) px[i] = ColorBrightnessUp(px[i], factor, 0x0);
+        else if ((masterBrightness >> 14) == 2) px[i] = ColorBrightnessDown(px[i], factor, 0xF);
+        u32 c = px[i];
+        u32 r = (c << 18) & 0xFC0000;
+        u32 g = (c << 2) & 0xFC00;
+        u32 b = (c >> 14) & 0xFC;
+        c = r | g | b;
+        px[i] = c | ((c & 0xC0C0C0) >> 6) | 0xFF000000;
+    }
+}
+
+// GoldLink: the line's side strips. The line is composed twice more, every horizontal position
+// shifted by 256 (backgrounds' scroll and affine references, sprites' x, the 3D layer taken
+// from the wide 3D buffer), so what lies just off each edge is drawn as the game would draw it;
+// everything a pass changes is put back.
+void SoftRenderer::DrawWideSides(u32 line, int n3dline, u32* dst)
+{
+    const int side = std::min(GPU.GPU3D.WideSide, MaxSide);
+    const int unit = CurUnit->Num;
+    WideOwner[unit] = Framebuffer[unit];
+    WideDrawn[unit] = side;
+
+    alignas(8) u32 savedOBJ[256];
+    alignas(8) u8 savedOBJWindow[256];
+    memcpy(savedOBJ, OBJLine[unit], sizeof(savedOBJ));
+    memcpy(savedOBJWindow, OBJWindow[unit], sizeof(savedOBJWindow));
+    auto mosaicY = CurUnit->OBJMosaicY;
+    auto mosaicYCount = CurUnit->OBJMosaicYCount;
+    u16 xpos[4];
+    memcpy(xpos, CurUnit->BGXPos, sizeof(xpos));
+    s32 xref[2] = {CurUnit->BGXRefInternal[0], CurUnit->BGXRefInternal[1]};
+    s32 yref[2] = {CurUnit->BGYRefInternal[0], CurUnit->BGYRefInternal[1]};
+    u32* saved3D = _3DLine;
+
+    u32* wide3D = nullptr;
+    if (unit == 0 && !GPU.GPU3D.IsRendererAccelerated() && GPU.GPU3D.GetRenderXPos() == 0)
+        wide3D = static_cast<melonDS::SoftRenderer&>(GPU.GPU3D.GetCurrentRenderer()).GetWideLine(n3dline);
+    const int m = melonDS::GPU3D::MaxWideSide;
+
+    for (int pass = 0; pass < 2; pass++)
+    {
+        SideShift = pass == 0 ? -256 : 256;
+        for (int i = 0; i < 4; i++)
+            CurUnit->BGXPos[i] = (u16)(xpos[i] + SideShift);
+        for (int i = 0; i < 2; i++)
+        {
+            CurUnit->BGXRefInternal[i] = xref[i] + SideShift * CurUnit->BGRotA[i];
+            CurUnit->BGYRefInternal[i] = yref[i] + SideShift * CurUnit->BGRotC[i];
+        }
+        memset(Side3DLine, 0, sizeof(Side3DLine));
+        if (wide3D)
+        {
+            if (pass == 0)
+                for (int x = 256 - side; x < 256; x++) Side3DLine[x] = wide3D[m - 256 + x];
+            else
+                for (int x = 0; x < side; x++) Side3DLine[x] = wide3D[m + 256 + x];
+        }
+        _3DLine = Side3DLine;
+
+        DrawSprites(line, CurUnit);
+        CurUnit->OBJMosaicY = mosaicY;
+        CurUnit->OBJMosaicYCount = mosaicYCount;
+        DrawScanline_BGOBJ(line);
+        FinishPixels(BGOBJLine, 256);
+
+        u32* out = WideSides[unit][line];
+        if (pass == 0)
+            memcpy(out, &BGOBJLine[256 - side], side * 4);
+        else
+            memcpy(out + MaxSide, &BGOBJLine[0], side * 4);
+    }
+
+    SideShift = 0;
+    memcpy(CurUnit->BGXPos, xpos, sizeof(xpos));
+    for (int i = 0; i < 2; i++)
+    {
+        CurUnit->BGXRefInternal[i] = xref[i];
+        CurUnit->BGYRefInternal[i] = yref[i];
+    }
+    memcpy(OBJLine[unit], savedOBJ, sizeof(savedOBJ));
+    memcpy(OBJWindow[unit], savedOBJWindow, sizeof(savedOBJWindow));
+    CurUnit->OBJMosaicY = mosaicY;
+    CurUnit->OBJMosaicYCount = mosaicYCount;
+    _3DLine = saved3D;
+    (void)dst;
 }
 
