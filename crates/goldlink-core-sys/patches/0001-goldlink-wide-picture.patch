+    alignas(8) u32 Side3DLine[256];
+    void DrawWideSides(u32 line, int n3dline, u32* dst);
+    void FinishPixels(u32* px, int count);
+    // A sprite's x for this pass. Shifted past the line's end, it lies outside this strip:
+    // -512 makes the callers skip it (they skip x <= -width).
+    s32 SpriteX(u16 attrib1) const
+    {
+        s32 x = (s32)(attrib1 << 23) >> 23;
+        if (SideShift < 0) x += 256;
+        else if (SideShift > 0) x = (s32)(attrib1 & 0x1FF) - 256;
