+    // GoldLink (UC9 §4): with GPU3D::WideSide > 0, each line of the regular display also gets
+    // its side strips: the pixels just left and right of the screen, composed by this renderer
+    // as the game would (backgrounds, sprites, the wide 3D layer, effects, brightness), by
+    // running the line again with every horizontal position shifted by 256.
+    static constexpr int MaxSide = 64;
+    // Per engine: [line][0..side) the left strip, [line][MaxSide..MaxSide+side) the right.
+    u32 WideSides[2][192][2 * MaxSide] {};
