+++ b/src/GPU3D_Soft.h	2026-11-13 21:52:24.897849230 -0500
@@ -317,7 +317,7 @@
                 else                     dx = 0;
             }
 
-            dx += (y - y0) * Increment;
+            dx += (s64)(y - y0) * Increment;
 
             s32 x = XVal();
 
