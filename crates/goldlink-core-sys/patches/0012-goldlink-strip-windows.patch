 // shifted by 256 (backgrounds' scroll and affine references, sprites' x, the 3D layer taken
 // from the wide 3D buffer), so what lies just off each edge is drawn as the game would draw it;
 // everything a pass changes is put back.
+// GoldLink: where window w is inside on this line of the screen (as CalculateWindowMask runs it,
+// from the same state): its first inside column and one past its last (-1, -1 if none).
+void SoftRenderer::RecordWindow(u32 line, int w, u32 active, const u8* coords, bool enabled)
+{
+    s16 first = -1, last = -1;
+    if (enabled)
+    {
+        for (int i = 0; i < 256; i++)
+        {
+            if (i == coords[1])      active &= ~0x2;
+            else if (i == coords[0]) active |=  0x2;
+            if (active == 0x3)
+            {
+                if (first < 0) first = (s16)i;
+                last = (s16)(i + 1);
+            }
+        }
+    }
+    WinL[0][w][line] = first;
+    WinR[0][w][line] = last;
+}
+
+// GoldLink: how far past the screen's left (side 0) or right edge window w reaches on this line.
+// Inside at the edge, the window may end just past it or far past it: its outline is followed
+// from the nearest lines above and below where it shows within the screen, continued at the
+// rate it was moving there, and the nearer guess taken (a circle that only grazes the edge
+// reaches a pixel or two past it). Where its edge is the screen's on every line (a wipe), it
+// covers the whole strip. Lines below this one come from the frame before.
+int SoftRenderer::WindowReach(int w, int side, u32 line)
+{
+    auto at = [&](int y) -> int {
+        const int frame = y <= (int)line ? 0 : 1;
+        return side == 0 ? WinL[frame][w][y] : (WinR[frame][w][y] < 0 ? -1 : 256 - WinR[frame][w][y]);
+    };
+    // at(y): the distance from the edge to where the window starts (0: at the edge, -1: none).
+    if (at(line) != 0)
+        return 0;
+    int reach = MaxSide;
+    for (int dir = -1; dir <= 1; dir += 2)
+    {
+        int y = (int)line + dir;
+        while (y >= 0 && y < 192 && at(y) == 0)
+            y += dir;
+        if (y < 0 || y >= 192 || at(y) < 0)
+            continue;
+        const int p = at(y), d = std::abs(y - (int)line);
+        const int further = y + dir;
+        const int step = (further >= 0 && further < 192 && at(further) > 0) ? at(further) - p : 1;
+        const int beyond = d * std::max(step, 0) - p; // past the edge, by the outline's own rate
+        reach = std::min(reach, std::max(beyond, 0));
+    }
+    return reach;
+}
+
+// GoldLink: a strip pass's window mask: outside, the sprites' own window (drawn for the strip),
+// then windows 1 and 0 where they reach past the edge.
+void SoftRenderer::SideWindowMask(u32 line)
+{
+    const u8* win = CurUnit->WinCnt;
+    const u32 cnt = CurUnit->DispCnt;
+    const int left = SideShift < 0 ? 1 : 0;
+    // Recorded for the main engine's lines (the top screen's strips) only.
+    const bool main = CurUnit->Num == 0 && line < 192;
+    const int reach0 = main && (cnt & (1 << 13)) ? WindowReach(0, left ? 0 : 1, line) : 0;
+    const int reach1 = main && (cnt & (1 << 14)) ? WindowReach(1, left ? 0 : 1, line) : 0;
+    for (int i = 0; i < 256; i++)
+    {
+        const int k = left ? 256 - i : i + 1; // pixels past the edge
+        u8 m = win[2];
+        if ((cnt & (1 << 15)) && OBJWindow[CurUnit->Num][i])
+            m = win[3];
+        if (k <= reach1)
+            m = win[1];
+        if (k <= reach0)
+            m = win[0];
+        WindowMask[i] = m;
+    }
+}
