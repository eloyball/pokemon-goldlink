+    // GoldLink (UC11): the overworld drawn with an orthographic camera, its world locked to the
+    // screen's pixels. HeartGold's field camera is a narrow perspective one; as it moves, the
+    // ground near the bottom of the screen slides 1.6 times as fast as at the top, every corner
+    // re-rounds to another whole pixel and the scene shimmers. With OrthoWanted (GoldLink sets
+    // it while the game is in the overworld and the setting is on), a field projection (the
+    // perspective HeartGold loads before each object) is replaced, once the camera matrix after
+    // it is known, by an orthographic one: the same angle, the same scale at the player's
+    // distance, and the camera shifted so the world's origin always lands at the same point
+    // within a pixel. Every world point then keeps its sub-pixel phase: the scene moves in whole
+    // pixels, rigidly. OrthoShift is that shift (pixels, screen x and y); GoldLink slides the
+    // shown picture back by it at the screen's resolution.
+    //
+    // Depth keeps the game's own: z/w of the perspective, matched in value and slope at the
+    // player's distance (the game draws sprites, shadows and the surf mount with a second
+    // projection whose depth term pulls them toward the camera; a plain orthographic depth loses
+    // that). Every w is OrthoW, a constant, so the fixed-point terms keep their precision, and
+    // the frame is depth-buffered by Z (with constant w, W-buffering can't sort).
+    static constexpr double OrthoW = 64;
+    bool OrthoWanted = false;
+    double OrthoDepth = 656;       // the player's distance (view units), from the last scenes
+    bool OrthoArmed = false;       // a field projection was loaded: the camera matrix comes next
+    bool OrthoFromPersp = false;   // it's the overworld's perspective (rooms' are orthographic)
+    s32 OrthoPersp[16] {};         // that projection
+    bool OrthoScene = false;       // the scene being built uses it
+    bool OrthoSceneFromPersp = false; // and was the overworld's perspective (Z-buffered then)
+    float OrthoShift[2] {};        // the scene being built's shift
+    float RenderOrthoShift[2] {};  // the frame being rendered's
+    float ShownOrthoShift[2] {};   // the frame on screen's
+    bool RenderOrtho = false, ShownOrtho = false;
+    bool OrthoFlushed = false;     // the scene flushed (waiting for the swap) used it
+    float OrthoFlushedShift[2] {};
+    double OrthoNear = 0;          // this scene: the object nearest the screen's centre (distance)
+    double OrthoNearScore = 1e30;
+    // The player's distance is learned once per camera setup (the projection's scale and the
+    // camera's angle), from the first scenes, and kept: walking, stairs or another object passing
+    // the centre never change the scale, so the picture never zooms.
+    struct OrthoCamera { s32 Key[5]; double Depth; double Seen[5]; int NumSeen; };
+    OrthoCamera OrthoCameras[8] {};
+    int NumOrthoCameras = 0, OrthoCameraAt = -1;
+    void OrthoProjection(const s32* camera) noexcept;
+    void OrthoObject() noexcept;
+    void OrthoEndScene() noexcept;
+
