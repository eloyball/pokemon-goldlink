+// GoldLink (UC11): see GPU3D.h, OrthoWanted.
+void GPU3D::OrthoProjection(const s32* camera) noexcept
+{
+    OrthoArmed = false;
+    const s32* p = OrthoPersp;
+    s32 m[16] {};
+    if (OrthoFromPersp)
+    {
+        // This camera setup's learned distance (until it's learned, the last one in use).
+        const s32 key[5] = {p[0], p[5], camera[4], camera[5], camera[8]};
+        int at = -1;
+        for (int i = 0; i < NumOrthoCameras; i++)
+            if (memcmp(OrthoCameras[i].Key, key, sizeof(key)) == 0)
+                at = i;
+        if (at < 0)
+        {
+            at = NumOrthoCameras < 8 ? NumOrthoCameras++ : 0;
+            OrthoCameras[at] = OrthoCamera {};
+            memcpy(OrthoCameras[at].Key, key, sizeof(key));
+        }
+        OrthoCameraAt = at;
+        if (OrthoCameras[at].Depth > 0)
+            OrthoDepth = OrthoCameras[at].Depth;
+        const double K = OrthoW, d = OrthoDepth;
+        // The perspective's depth z/w = -m10 - m14/vz, as a line through its value and slope at -d.
+        const double m10 = p[10] / 4096.0, m14 = p[14] / 4096.0;
+        const double c1 = m14 / (d * d), c0 = -m10 + 2 * m14 / d;
+        m[0] = (s32)std::lround(K * p[0] / d);
+        m[5] = (s32)std::lround(K * p[5] / d);
+        m[10] = (s32)std::lround(K * c1 * 4096);
+        m[14] = (s32)std::lround(K * c0 * 4096);
+        m[15] = (s32)std::lround(K * 4096);
+    }
+    else
+        memcpy(m, p, sizeof(m)); // a room: already orthographic, only snapped
+    // Where the world's origin lands (the camera's translation through that view), shifted to
+    // the middle of its pixel: every world point keeps its phase within a pixel.
+    const double w = m[15] / 4096.0;
+    const double cx = ((camera[9] / 4096.0) * (m[0] / 4096.0) + m[12] / 4096.0) / w;
+    const double cy = ((camera[10] / 4096.0) * (m[5] / 4096.0) + m[13] / 4096.0) / w;
+    const double x = Viewport[0] + (cx + 1) * Viewport[4] / 2.0;
+    const double y = Viewport[3] + (1 - cy) * Viewport[5] / 2.0;
+    const double ox = std::floor(x) + 0.5 - x, oy = std::floor(y) + 0.5 - y;
+    m[12] += (s32)std::lround(w * ox * 2.0 / Viewport[4] * 4096);
+    m[13] += (s32)std::lround(-w * oy * 2.0 / Viewport[5] * 4096);
+    memcpy(ProjMatrix, m, sizeof(m));
+    ClipMatrixDirty = true;
+    OrthoShift[0] = (float)ox;
+    OrthoShift[1] = (float)oy;
+    OrthoScene = true;
+    OrthoSceneFromPersp |= OrthoFromPersp;
+}
+
+// GoldLink (UC11): an object placed in the scene (its position in view space is the position
+// matrix's translation): the one nearest the screen's centre, through the game's perspective,
+// is taken for the player, whose distance the orthographic scale is matched at.
+void GPU3D::OrthoObject() noexcept
+{
+    if (!OrthoScene || !OrthoFromPersp)
+        return;
+    const double vx = PosMatrix[12] / 4096.0, vy = PosMatrix[13] / 4096.0, vz = PosMatrix[14] / 4096.0;
+    if (vz > -16)
+        return;
+    const double sx = (OrthoPersp[0] / 4096.0) * vx / -vz, sy = (OrthoPersp[5] / 4096.0) * vy / -vz;
+    const double score = sx * sx + (sy + 0.15) * (sy + 0.15); // the player stands a little low
+    if (score < OrthoNearScore)
+    {
+        OrthoNearScore = score;
+        OrthoNear = -vz;
+    }
+}
+
+// GoldLink (UC11): a scene was flushed. A camera setup seen for the first time learns the
+// player's distance from its first five scenes (the median), then keeps it.
+void GPU3D::OrthoEndScene() noexcept
+{
+    OrthoFlushed = OrthoScene;
+    memcpy(OrthoFlushedShift, OrthoShift, sizeof(OrthoFlushedShift));
+    if (OrthoSceneFromPersp && OrthoCameraAt >= 0 && OrthoNearScore < 0.05)
+    {
+        OrthoCamera &c = OrthoCameras[OrthoCameraAt];
+        if (c.Depth <= 0 && c.NumSeen < 5)
+        {
+            c.Seen[c.NumSeen++] = OrthoNear;
+            if (c.NumSeen == 5)
+            {
+                double s[5];
+                memcpy(s, c.Seen, sizeof(s));
+                std::sort(s, s + 5);
+                c.Depth = s[2];
+                OrthoDepth = c.Depth;
+            }
+        }
+    }
+    OrthoScene = false;
+    OrthoSceneFromPersp = false;
+    OrthoArmed = false;
+    OrthoNearScore = 1e30;
+}
