-    struct ShadowCacheEntry { u32 Key[6]; u8 Shadow; u8 SoftAlpha; };
-    u8 GameShadow(const GPU& gpu, const Polygon* p, u8* softAlpha);
+    struct ShadowCacheEntry { u32 Key[6]; u8 Shadow; u8 SoftAlpha; float Dark; };
+    u8 GameShadow(const GPU& gpu, const Polygon* p, u8* softAlpha, float* dark);
     std::vector<ShadowCacheEntry> ShadowCache;
     // 0 not one, 1 the game's shadow, 2 a painted one (and the polygon alpha that leaves it just
     // visible into *softAlpha).
