     // and in front of that (UnderDepth). The window shows it where the world slides out from
     // under the player's layer (half a pixel at most), instead of a guess.
     const u32* GetShownUnderLine(int line) const { return &ShownUnder[line * ScanlineWidth]; }
+    // GoldLink (UC11): where something of the world is in front of an attached object, the
+    // attached object's own opaque pixel behind it (ColorBuffer's format; 0: none), the nearest.
+    // The window draws the player's layer whole and what's in front over it with the world's
+    // shift (the two slide apart by a fraction: an outline round anything in front of the player,
+    // the user's play test).
+    const u32* GetShownBehindLine(int line) const { return &ShownBehind[line * ScanlineWidth]; }
+    // Its depth (DepthBuffer's format).
+    const u32* GetShownBehindDepthLine(int line) const { return &ShownBehindDepth[line * ScanlineWidth]; }
+    // Where the world's pixel over an attached object is an edge (an outline, a polygon's side),
+    // that edge's own colour (ColorBuffer's format) with its coverage (0..31) in bits 24-28, bit
+    // 31 set; else 0. The picture has it blended with the world under the attached object (it
+    // was blended with the attached object's pixel: the player's colours in the roof's outline,
+    // where they no longer are once their layer slides apart, the user's play test); the window
+    // blends it over whatever it covers on screen.
+    const u32* GetShownFrontEdgeLine(int line) const { return &ShownFrontEdge[line * ScanlineWidth]; }
 
