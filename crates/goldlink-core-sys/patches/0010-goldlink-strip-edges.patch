+// GoldLink: a text background's colour at map column xpos of this line (as DrawBG_Text reads
+// it, mosaic aside), or -1 where it's transparent.
+s32 SoftRenderer::TextColourAt(u32 line, u32 bgnum, u16 xpos)
+{
+    u16 bgcnt = CurUnit->BGCnt[bgnum];
+    u16 yoff = CurUnit->BGYPos[bgnum] + line;
+    if (bgcnt & 0x0040)
+        yoff -= CurUnit->BGMosaicY;
+    u32 widexmask = (bgcnt & 0x4000) ? 0x100 : 0;
+    u8* bgvram;
+    u32 bgvrammask;
+    CurUnit->GetBGVRAM(bgvram, bgvrammask);
+    u32 tilesetaddr, tilemapaddr;
+    u16* pal;
+    if (CurUnit->Num)
+    {
+        tilesetaddr = ((bgcnt & 0x003C) << 12);
+        tilemapaddr = ((bgcnt & 0x1F00) << 3);
+        pal = (u16*)&GPU.Palette[0x400];
+    }
+    else
+    {
+        tilesetaddr = ((CurUnit->DispCnt & 0x07000000) >> 8) + ((bgcnt & 0x003C) << 12);
+        tilemapaddr = ((CurUnit->DispCnt & 0x38000000) >> 11) + ((bgcnt & 0x1F00) << 3);
+        pal = (u16*)&GPU.Palette[0];
+    }
+    if (bgcnt & 0x8000)
+    {
+        tilemapaddr += ((yoff & 0x1F8) << 3);
+        if (bgcnt & 0x4000)
+            tilemapaddr += ((yoff & 0x100) << 3);
+    }
+    else
+        tilemapaddr += ((yoff & 0xF8) << 3);
+    u16 tile = *(u16*)&bgvram[(tilemapaddr + ((xpos & 0xF8) >> 2) + ((xpos & widexmask) << 3)) & bgvrammask];
+    u32 tilex = (tile & 0x0400) ? (7 - (xpos & 0x7)) : (xpos & 0x7);
+    u32 tiley = (tile & 0x0800) ? (7 - (yoff & 0x7)) : (yoff & 0x7);
+    if (bgcnt & 0x0080)
+    {
+        u8 color = bgvram[(tilesetaddr + ((tile & 0x03FF) << 6) + (tiley << 3) + tilex) & bgvrammask];
+        if (!color)
+            return -1;
+        if (CurUnit->DispCnt & 0x40000000)
+        {
+            u32 slot = ((bgnum < 2) && (bgcnt & 0x2000)) ? (2 + bgnum) : bgnum;
+            return CurUnit->GetBGExtPal(slot, tile >> 12)[color];
+        }
+        return pal[color];
+    }
+    u8 pair = bgvram[(tilesetaddr + ((tile & 0x03FF) << 5) + (tiley << 2) + (tilex >> 1)) & bgvrammask];
+    u8 color = (tilex & 1) ? (pair >> 4) : (pair & 0x0F);
+    if (!color)
+        return -1;
+    return (pal + ((tile & 0xF000) >> 8))[color];
+}
+
+// GoldLink: this line of a text background (scrolled to x0) at the screen's edges: 1 one
+// colour over its first and last 8 pixels (a fill reaching both edges, a wipe), 0 transparent
+// at an edge, -1 shown at both edges but not as a fill (a picture, a frame, a pattern).
+int SoftRenderer::TextFilledAtEdges(u32 line, u32 bgnum, u16 x0)
+{
+    s32 c = TextColourAt(line, bgnum, x0);
+    if (c < 0 || TextColourAt(line, bgnum, (u16)(x0 + 255)) < 0)
+        return 0;
+    for (int i = 0; i < 8; i++)
+        if (TextColourAt(line, bgnum, (u16)(x0 + i)) != c || TextColourAt(line, bgnum, (u16)(x0 + 255 - i)) != c)
+            return -1;
+    return 1;
+}
