+// GoldLink (UC11): see GPU3D.h, AttachedKeys. At a swap (MidObjects the scene swapped in,
+// MidRenderObjects the one before): while the camera moves, the objects that stay put on screen
+// (their move, less the change of shift, under half the camera's and at most a pixel: a surf
+// mount bobs) are the ones it follows, for the next scenes. With the camera still they are kept; after a jump (a warp) or outside
+// the steady overworld, there are none.
+void GPU3D::MidClassify() noexcept
+{
+    if (!MidWanted || !RenderOrtho || !PrevOrtho || MidObjects.empty() || MidRenderObjects.empty())
+    {
+        AttachedKeys.clear();
+        AttachedValid = false;
+        return;
+    }
+    const double tx = RenderOrthoOrigin[0] - PrevOrthoOrigin[0], ty = RenderOrthoOrigin[1] - PrevOrthoOrigin[1];
+    if (std::fabs(tx) < 0.3 && std::fabs(ty) < 0.3)
+        return;
+    constexpr double Reach = 48;
+    if (std::fabs(tx) > Reach || std::fabs(ty) > Reach)
+    {
+        AttachedKeys.clear();
+        AttachedValid = false;
+        return;
+    }
+    const double dox = RenderOrthoShift[0] - PrevOrthoShift[0], doy = RenderOrthoShift[1] - PrevOrthoShift[1];
+    const double still = std::min(1.0, std::max(std::fabs(tx), std::fabs(ty)) / 2);
+    std::unordered_multimap<u64, u32> before;
+    before.reserve(MidRenderObjects.size());
+    auto key = [](const MidObject& o) { return ((u64)o.Key << 32) | o.Verts; };
+    for (u32 i = 0; i < MidRenderObjects.size(); i++)
+        if (MidRenderObjects[i].Placed)
+            before.emplace(key(MidRenderObjects[i]), i);
+    std::vector<AttachedObject> found;
+    u32 most = 0;
+    double ref[2] = {0, 0};
+    for (const MidObject& c : MidObjects)
+    {
+        if (!c.Placed)
+            continue;
+        auto [from, to] = before.equal_range(key(c));
+        for (auto it = from; it != to; ++it)
+        {
+            const MidObject& b = MidRenderObjects[it->second];
+            if (std::fabs(c.X - b.X - dox) < still && std::fabs(c.Y - b.Y - doy) < still)
+            {
+                const double x = c.X - RenderOrthoShift[0], y = c.Y - RenderOrthoShift[1];
+                found.push_back({c.Key, x, y, 0, 0});
+                if (c.Verts > most)
+                {
+                    most = c.Verts;
+                    ref[0] = x;
+                    ref[1] = y;
+                }
+                break;
+            }
+        }
+    }
+    // Each one's offset from the reference in whole pixels, so every one of them is drawn at the
+    // same phase within a pixel (a sixteenth of a pixel still flipped texels as a surf mount
+    // bobbed); kept from the last swap until it's 3/4 of a pixel off (a shadow half a pixel from
+    // the player would otherwise flip between two).
+    for (AttachedObject& a : found)
+    {
+        const double rx = a.X - ref[0], ry = a.Y - ref[1];
+        a.RelX = std::round(rx);
+        a.RelY = std::round(ry);
+        for (const AttachedObject& old : AttachedKeys)
+            if (old.Key == a.Key && std::fabs(old.X - a.X) < AttachNear && std::fabs(old.Y - a.Y) < AttachNear)
+            {
+                if (std::fabs(rx - old.RelX) < 0.75)
+                    a.RelX = old.RelX;
+                if (std::fabs(ry - old.RelY) < 0.75)
+                    a.RelY = old.RelY;
+                break;
+            }
+    }
+    AttachedKeys = std::move(found);
+    AttachedValid = !AttachedKeys.empty();
+    if (AttachedValid)
+    {
+        AttachedRef[0] = ref[0];
+        AttachedRef[1] = ref[1];
+    }
+}
