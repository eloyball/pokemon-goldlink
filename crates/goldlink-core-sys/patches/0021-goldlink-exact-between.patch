+// GoldLink (UC11): whether ColorComposite blends the top layer val1 (2D) with val2, the 3D
+// layer: its alpha blending (a semi-transparent sprite or a blend target pair), as it decides.
+bool SoftRenderer::BlendsWith3D(int i, u32 val1, u32 val2) const
+{
+    const u32 flag1 = val1 >> 24, flag2 = val2 >> 24;
+    const u32 blendCnt = CurUnit->BlendCnt;
+    if ((flag2 & 0xC0) != 0x40 || !(blendCnt & 0x0100))
+        return false;
+    if (flag1 & 0x80)
+        return true;
+    return (blendCnt & flag1) && (WindowMask[i] & 0x20) && ((blendCnt >> 6) & 0x3) == 1;
+}
