+// GoldLink (UC11): counts the polygon being added against the projection it uses.
+void GPU3D::CountFrameProj() noexcept
+{
+    for (int i = 0; i < NumFrameProj; i++)
+    {
+        if (memcmp(FrameProj[i].Matrix, ProjMatrix, sizeof(ProjMatrix)) == 0)
+        {
+            FrameProj[i].Polygons++;
+            return;
+        }
+    }
+    if (NumFrameProj < 4)
+    {
+        memcpy(FrameProj[NumFrameProj].Matrix, ProjMatrix, sizeof(ProjMatrix));
+        FrameProj[NumFrameProj++].Polygons = 1;
+    }
+}
