GoldLink's change to melonDS (KNOWN_RISKS #135): the game's own light on its map sprites.

HeartGold lights its map and its map sprites through the DS's lighting by the time of day: the
vertices' colour modulates the texture (63, 63, 63 by day; 37, 37, 55 at night). 2D sprites aren't
lit so: lit as the player by GoldLink (patch 0035), Fly's landing trainer still landed brighter
than the player's 3D sprite by evening and night (the user's play test, 2026-11-19). GPU3D keeps
the scene's commonest vertex colour (RenderSpriteTint, then ShownSpriteTint with the frame on
screen) for the lighting to tint 2D sprites on the scene with.

Applied by build.rs to a copy of the submodule (which stays at upstream).

diff --git a/src/GPU3D.cpp b/src/GPU3D.cpp
index 00c4f1b..0f5ff78 100644
--- a/src/GPU3D.cpp
+++ b/src/GPU3D.cpp
@@ -2959,6 +2959,7 @@ void GPU3D::VBlank() noexcept
             ShownAttach = RenderAttach;
             memcpy(ShownAttachSlide, RenderAttachSlide, sizeof(ShownAttachSlide));
             memcpy(ShownAttachTrue, RenderAttachTrue, sizeof(ShownAttachTrue));
+            memcpy(ShownSpriteTint, RenderSpriteTint, sizeof(ShownSpriteTint));
             memcpy(ShownOrthoOrigin, MidShown ? MidOrthoOrigin : RenderOrthoOrigin, sizeof(ShownOrthoOrigin));
             memcpy(ShownOrthoShift, MidShown ? MidOrthoShift : RenderOrthoShift, sizeof(ShownOrthoShift));
             // GoldLink (UC11): the picture in between was shown; the scene's own list is back,
@@ -2981,6 +2982,45 @@ void GPU3D::VBlank() noexcept
                 RenderAttach = FlushedAttach;
                 memcpy(RenderAttachSlide, FlushedAttachSlide, sizeof(RenderAttachSlide));
                 memcpy(RenderAttachTrue, FlushedAttachTrue, sizeof(RenderAttachTrue));
+                // GoldLink (KNOWN_RISKS #135): the game's light on the scene by the time of day: the
+                // commonest vertex colour (its top 6 bits, which the renderer modulates with) of
+                // the scene's textured, unshadowed polygons. HeartGold lights its map and its map
+                // sprites with it (63 by day; 37, 37, 55 at night); baked shades are rarer.
+                {
+                    u32 keys[64];
+                    int counts[64];
+                    int distinct = 0;
+                    for (u32 p = 0; p < NumPolygons; p++)
+                    {
+                        const Polygon& poly = CurPolygonRAM[p];
+                        if (!poly.NumVertices || poly.IsShadow || poly.IsShadowMask || poly.Degenerate
+                            || ((poly.TexParam >> 26) & 0x7) == 0 || ((poly.Attr >> 4) & 0x3) != 0)
+                            continue;
+                        const s32* c = poly.Vertices[0]->FinalColor;
+                        u32 key = ((u32)(c[0] >> 3) << 12) | ((u32)(c[1] >> 3) << 6) | (u32)(c[2] >> 3);
+                        int k = 0;
+                        while (k < distinct && keys[k] != key)
+                            k++;
+                        if (k == distinct)
+                        {
+                            if (distinct == 64)
+                                continue;
+                            keys[distinct] = key;
+                            counts[distinct++] = 0;
+                        }
+                        counts[k]++;
+                    }
+                    int best = -1;
+                    for (int k = 0; k < distinct; k++)
+                        if (best < 0 || counts[k] > counts[best])
+                            best = k;
+                    if (best >= 0)
+                    {
+                        RenderSpriteTint[0] = (float)(((keys[best] >> 12) & 63) + 1) / 64.0f;
+                        RenderSpriteTint[1] = (float)(((keys[best] >> 6) & 63) + 1) / 64.0f;
+                        RenderSpriteTint[2] = (float)((keys[best] & 63) + 1) / 64.0f;
+                    }
+                }
                 memcpy(RenderOrthoShift, OrthoFlushedShift, sizeof(RenderOrthoShift));
                 memcpy(RenderOrthoOrigin, OrthoFlushedOrigin, sizeof(RenderOrthoOrigin));
 
diff --git a/src/GPU3D.h b/src/GPU3D.h
index 48d2740..58f3eda 100644
--- a/src/GPU3D.h
+++ b/src/GPU3D.h
@@ -489,6 +489,11 @@ public:
     bool FlushedAttach = false, RenderAttach = false, ShownAttach = false;
     float FlushedAttachSlide[2] {}, RenderAttachSlide[2] {}, ShownAttachSlide[2] {};
     double FlushedAttachTrue[2] {}, RenderAttachTrue[2] {}, ShownAttachTrue[2] {};
+    // GoldLink (KNOWN_RISKS #135): the game's own light on its map and map sprites by the time of
+    // day: the scene's commonest vertex colour, (c + 1) / 64 per channel as the DS modulates a
+    // texel with it (the last one kept while no scene comes). The lighting tints 2D sprites on the
+    // scene with it, as the player's 3D sprite is tinted.
+    float RenderSpriteTint[3] { 1.0f, 1.0f, 1.0f }, ShownSpriteTint[3] { 1.0f, 1.0f, 1.0f };
     void MidClassify() noexcept;
     std::unique_ptr<GPU3D> MidShadow;
     std::array<Polygon*,2048> MidList {}, MidSavedList {};
