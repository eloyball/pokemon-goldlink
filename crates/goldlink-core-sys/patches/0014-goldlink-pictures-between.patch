+// A new scene was just swapped in after one shown for two frames: for its first frame, it's
+// replayed with every object halfway back to where it was in the last, and that's rendered.
+bool GPU3D::MidPrepare() noexcept
+{
+    if (!MidLogOk || !MidShadow || MidLog.empty() || MidObjects.empty() || MidRenderObjects.empty()
+        || RenderNumPolygons == 0)
+    {
+        MidStats[1]++;
+        return false;
+    }
+    auto key = [](const MidObject& o) { return ((u64)o.Key << 32) | o.Verts; };
+    std::unordered_multimap<u64, u32> before;
+    before.reserve(MidRenderObjects.size());
+    for (u32 i = 0; i < MidRenderObjects.size(); i++)
+        if (MidRenderObjects[i].Placed)
+            before.emplace(key(MidRenderObjects[i]), i);
+
+    // The scene's overall motion: the most common move (to a quarter pixel) between objects
+    // alike within reach.
+    constexpr float Reach = 48, Near = 16;
+    std::map<std::pair<long, long>, u32> votes;
+    for (const MidObject& c : MidObjects)
+    {
+        if (!c.Placed)
+            continue;
+        auto [from, to] = before.equal_range(key(c));
+        for (auto it = from; it != to; ++it)
+        {
+            const MidObject& b = MidRenderObjects[it->second];
+            const float dx = c.X - b.X, dy = c.Y - b.Y;
+            if (std::fabs(dx) <= Reach && std::fabs(dy) <= Reach)
+                votes[{std::lround(dx * 4), std::lround(dy * 4)}]++;
+        }
+    }
+    float gx = 0, gy = 0;
+    u32 most = 0;
+    for (const auto& [move, n] : votes)
+        if (n > most)
+        {
+            most = n;
+            gx = move.first / 4.0f;
+            gy = move.second / 4.0f;
+        }
+    auto half = [](float v) { return (s32)std::floor(v / 2 + 0.5f); };
+    const s32 hx = half(-gx), hy = half(-gy);
+
+    // Each object: halfway back to its match (the one alike nearest where the overall motion,
+    // or no motion, puts it); with the world (half the overall motion) without one.
+    std::vector<s32> shift(MidObjects.size() * 2);
+    for (u32 j = 0; j < MidObjects.size(); j++)
+    {
+        const MidObject& c = MidObjects[j];
+        s32 sx = hx, sy = hy;
+        if (c.Placed)
+        {
+            float best = Near;
+            auto [from, to] = before.equal_range(key(c));
+            for (auto it = from; it != to; ++it)
+            {
+                const MidObject& b = MidRenderObjects[it->second];
+                const float dx = c.X - b.X, dy = c.Y - b.Y;
+                const float world = std::hypot(dx - gx, dy - gy);
+                const float cost = std::min(world, std::hypot(dx, dy));
+                if (cost <= best)
+                {
+                    best = cost;
+                    if (world < 0.3f)
+                        sx = hx, sy = hy;
+                    else
+                        sx = half(-dx), sy = half(-dy);
+                }
+            }
+        }
+        shift[j * 2] = sx;
+        shift[j * 2 + 1] = sy;
+    }
+
+    GPU3D& s = *MidShadow;
+    s.MidShift = std::move(shift);
+    s.MidReplaying = true;
+    s.MidObjects.clear();
+    s.MidCurObject = -1;
+    for (const CmdFIFOEntry& e : MidLog)
+    {
+        if (e.Command == 0x50)
+            break;
+        s.CmdPIPE.Write(e);
+        s.ExecuteCommand();
+    }
+    s.MidReplaying = false;
+    if (s.MidObjects.size() != MidObjects.size())
+    {
+        // The replay didn't build the same scene: nothing in between.
+        MidStats[1]++;
+        return false;
+    }
+
+    // Its list, as the swap would make it: opaque polygons, then translucent ones, Y-sorted.
+    u32 io = 0, it = s.NumOpaquePolygons;
+    for (u32 i = 0; i < s.NumPolygons; i++)
+    {
+        Polygon* poly = &s.CurPolygonRAM[i];
+        if (poly->Translucent)
+            MidList[it++] = poly;
+        else
+            MidList[io++] = poly;
+    }
+    std::stable_sort(MidList.begin(),
+        MidList.begin() + ((FlushAttributes & 0x1) ? s.NumOpaquePolygons : s.NumPolygons), YSort);
+
+    MidSavedList = RenderPolygonRAM;
+    MidSavedNumPolygons = RenderNumPolygons;
+    RenderPolygonRAM = MidList;
+    RenderNumPolygons = s.NumPolygons;
+    RenderFrameIdentical = false;
+    MidShown = true;
+    MidStats[0]++;
+    return true;
+}
+
+// The picture in between was shown: the scene's own list is back, to be drawn.
+void GPU3D::MidEndShown() noexcept
+{
+    RenderPolygonRAM = MidSavedList;
+    RenderNumPolygons = MidSavedNumPolygons;
+    MidShown = false;
+    MidRedraw = true;
+}
+
+}
