+// GoldLink (UC11): see GPU3D.h, MidWanted. A vertex: the first under a new clip matrix starts an
+// object, keyed by its first vertex and how it's drawn, placed where its origin lands on screen.
+void GPU3D::MidTrackVertex() noexcept
+{
+    if (MidCurObject < 0 || memcmp(MidLastClip, ClipMatrix, sizeof(MidLastClip)) != 0)
+    {
+        memcpy(MidLastClip, ClipMatrix, sizeof(MidLastClip));
+        MidObject o {};
+        o.Key = ((u32)(u16)CurVertex[0] | ((u32)(u16)CurVertex[1] << 16))
+            ^ ((u32)(u16)CurVertex[2] * 0x9E3779B1u) ^ (PolygonMode << 28) ^ ((CurPolygonAttr & 0xF0) << 20);
+        const double w = ClipMatrix[15];
+        const int width = MidWidth(), height = (int)Viewport[5];
+        if (w > 0 && width > 0 && height > 0)
+        {
+            o.X = (float)((WideX(ClipMatrix[12]) / w + 1) * width / 2);
+            o.Y = (float)((1 - ClipMatrix[13] / w) * height / 2);
+            o.Placed = std::fabs(o.X) < 4096 && std::fabs(o.Y) < 4096;
+        }
+        if (MidObjects.size() < 8192)
+            MidObjects.push_back(o);
+        MidCurObject = (int)MidObjects.size() - 1;
+    }
+    MidObjects[MidCurObject].Verts++;
+}
+
+// A new scene starts (its predecessor was just swapped in): its objects and commands are kept
+// from here, and the shadow takes the geometry state it starts from.
+void GPU3D::MidStartScene() noexcept
+{
+    MidRenderObjects.swap(MidObjects);
+    MidObjects.clear();
+    MidCurObject = -1;
+    MidLog.clear();
+    MidSceneFrames = 0;
+    MidLogOk = MidWanted;
+    if (!MidWanted)
+        return;
+    if (!MidShadow)
+        MidShadow = std::make_unique<GPU3D>(NDS);
+    MidShadow->MidCopyState(*this);
+}
+
