+// GoldLink (UC11): clipping with a guard band. A polygon cut at the picture's edge gets new
+// corners there, on whole pixels, while its own land between them: its texture mapping changes a
+// little as it slides past the edge, and with the steady overworld's world locked to the pixels
+// that showed as texels jumping a pixel near the edges (trees, the ground). With the band, the x
+// and y planes are GuardBand pixels past the picture (the rasterizer trims to the pixel): a
+// polygon crossing the edge keeps its own corners and is drawn exactly as it would be on screen.
+// Each pass scales the compared coordinate and w so the plane is the band's (exactly undone for
+// every corner that isn't new).
+static void GuardScale(Vertex* v, int nverts, int comp, s32 mc, s32 mw)
+{
+    for (int i = 0; i < nverts; i++)
+    {
+        v[i].Position[comp] *= mc;
+        v[i].Position[3] *= mw;
+    }
+}
+
+static s32 FloorDiv(s64 a, s64 b)
+{
+    return (s32)(a >= 0 ? a / b : -((-a + b - 1) / b));
+}
+
+static void GuardUnscale(Vertex* v, int nverts, int comp, s32 mc, s32 mw)
+{
+    for (int i = 0; i < nverts; i++)
+    {
+        v[i].Position[comp] = FloorDiv(v[i].Position[comp], mc);
+        v[i].Position[3] = FloorDiv(v[i].Position[3], mw);
+    }
+}
+
+int GPU3D::GuardClip(Vertex* vertices, int nverts, int clipstart) noexcept
+{
+    const s32 halfw = MidWidth() / 2, halfh = (s32)Viewport[5] / 2;
+    nverts = ClipAgainstPlane<2, true>(*this, vertices, nverts, clipstart);
+    GuardScale(vertices, nverts, 1, halfh, halfh + GuardBand);
+    nverts = ClipAgainstPlane<1, true>(*this, vertices, nverts, clipstart);
+    GuardUnscale(vertices, nverts, 1, halfh, halfh + GuardBand);
+    GuardScale(vertices, nverts, 0, halfw, halfw + GuardBand);
+    nverts = ClipAgainstPlane<0, true>(*this, vertices, nverts, clipstart);
+    GuardUnscale(vertices, nverts, 0, halfw, halfw + GuardBand);
+    return nverts;
+}
