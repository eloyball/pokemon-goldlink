+// GoldLink (UC13): see GetShownGeometry.
+void SoftRenderer::KeepGeometry(const GPU& gpu, Polygon* const* polys, int count, bool vramChanged)
+{
+    ShadowGeometry& g = RenderedGeometry;
+    g.Polys.clear();
+    g.Verts.clear();
+    g.Texs.clear();
+    g.Alpha.clear();
+    if (vramChanged)
+    {
+        TexCache.clear();
+        ShadowCache.clear();
+    }
+    std::vector<std::pair<u32, s32>> used; // cache entry -> index in g.Texs
+    HideList.assign(count, 0);
+    for (int i = 0; i < count; i++)
+    {
+        const Polygon* p = polys[i];
+        if (!p || p->NumVertices < 3 || p->Degenerate)
+            continue;
+        ShadowPoly sp {};
+        sp.FirstVert = (u32)g.Verts.size();
+        sp.NumVerts = p->NumVertices;
+        sp.Attr = p->Attr;
+        sp.TexParam = p->TexParam;
+        sp.TexPalette = p->TexPalette;
+        sp.Flags = (p->Attached ? ShadowAttached : 0) | (p->Translucent ? ShadowTranslucent : 0)
+            | (p->IsShadowMask ? ShadowMask : 0) | (p->IsShadow ? ShadowVolume : 0)
+            | (p->FacingView ? ShadowFacing : 0) | (p->Type == 1 ? ShadowLine : 0);
+        sp.Tex = -1;
+        for (u32 v = 0; v < p->NumVertices; v++)
+        {
+            const Vertex* vx = p->Vertices[v];
+            ShadowVert sv {};
+            for (int k = 0; k < 4; k++) sv.Clip[k] = vx->Position[k];
+            sv.ST[0] = vx->TexCoords[0];
+            sv.ST[1] = vx->TexCoords[1];
+            sv.Screen[0] = vx->FinalPosition[0];
+            sv.Screen[1] = vx->FinalPosition[1];
+            g.Verts.push_back(sv);
+        }
+        // Transparent texels: formats 1 and 6 (alpha), 5 (compressed), 7 (direct, alpha bit), and
+        // the paletted ones (2..4) with colour 0 transparent. Polygons drawn whole (alpha 31) cast
+        // through their texels that show (the windmill's soft-edged blades too); see-through ones
+        // (water, the game's own shadows) cast none.
+        const u32 format = (p->TexParam >> 26) & 7;
+        const u32 alpha = (p->Attr >> 16) & 0x1F;
+        const u32 param = p->TexParam & ~((0xFu << 16) | (3u << 30));
+        const u32 width = 8 << ((param >> 20) & 7), height = 8 << ((param >> 23) & 7);
+        const bool small = format != 0 && width * height <= 256 * 256;
+        const bool clear = format == 1 || format == 5 || format == 6 || format == 7
+            || (format >= 2 && format <= 4 && (p->TexParam & (1 << 29)));
+        const bool translucent = p->Translucent || (alpha > 0 && alpha < 31);
+        // The game's own shadows: translucent, dark where its texture shows.
+        if (small && translucent && !p->IsShadow && !p->IsShadowMask && GameShadow(gpu, p))
+            sp.Flags |= ShadowGame;
+        if (small && clear && alpha == 31 && !p->IsShadow && !p->IsShadowMask && !(sp.Flags & ShadowGame))
+        {
+            const size_t e = CacheTexture(gpu, param, p->TexPalette);
+            s32 index = -1;
+            for (const auto& u : used)
+                if (u.first == (u32)e) index = u.second;
+            if (index < 0)
+            {
+                index = (s32)g.Texs.size();
+                g.Texs.push_back({width, height, (u32)g.Alpha.size()});
+                g.Alpha.insert(g.Alpha.end(), TexCache[e].Alpha.begin(), TexCache[e].Alpha.end());
+                used.push_back({(u32)e, index});
+            }
+            sp.Tex = index;
+        }
+        HideList[i] = HideGameShadows && (sp.Flags & ShadowGame);
+        g.Polys.push_back(sp);
+    }
+}
+
+// GoldLink (UC13): a texture's transparency, decoded once until texture memory changes; its index
+// in TexCache.
+size_t SoftRenderer::CacheTexture(const GPU& gpu, u32 param, u32 palette)
+{
+    for (size_t e = 0; e < TexCache.size(); e++)
+        if (TexCache[e].Param == param && TexCache[e].Palette == palette)
+            return e;
+    const u32 width = 8 << ((param >> 20) & 7), height = 8 << ((param >> 23) & 7);
+    TexCacheEntry n {param, palette, std::vector<u8>(width * height), width, height};
+    for (u32 t = 0; t < height; t++)
+        for (u32 s = 0; s < width; s++)
+        {
+            u16 c;
+            u8 a;
+            TextureLookup(gpu, param, palette, (s16)(s << 4), (s16)(t << 4), &c, &a);
+            n.Alpha[t * width + s] = a;
+        }
+    TexCache.push_back(std::move(n));
+    return TexCache.size() - 1;
+}
