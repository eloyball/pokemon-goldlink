+// GoldLink (UC13): whether a translucent polygon is one of the game's own shadows: over the texels
+// it shows (its texture coordinates' extent), their mean colour a dark, near-neutral grey and the
+// polygon see-through there (its alpha times the texels', under 4/5). The game's are black or a
+// dark grey (the blobs under people, a house's or a sign's shadow, made faint by the polygon's
+// alpha) or a dark blue-grey of faint texels (the windmill's post, on the sheet with its blades);
+// water is coloured, sparkles white, the windmill's blades pale and its hub opaque. Kept until
+// texture memory changes (ShadowCache).
+bool SoftRenderer::GameShadow(const GPU& gpu, const Polygon* p)
+{
+    s32 s0 = INT32_MAX, s1 = INT32_MIN, t0 = INT32_MAX, t1 = INT32_MIN;
+    for (u32 v = 0; v < p->NumVertices; v++)
+    {
+        s0 = std::min<s32>(s0, p->Vertices[v]->TexCoords[0] >> 4);
+        s1 = std::max<s32>(s1, p->Vertices[v]->TexCoords[0] >> 4);
+        t0 = std::min<s32>(t0, p->Vertices[v]->TexCoords[1] >> 4);
+        t1 = std::max<s32>(t1, p->Vertices[v]->TexCoords[1] >> 4);
+    }
+    s1 = std::max(s1, s0 + 1);
+    t1 = std::max(t1, t0 + 1);
+    const u32 key[6] = {p->TexParam, p->TexPalette, (u32)s0, (u32)s1, (u32)t0, (u32)t1};
+    for (const auto& e : ShadowCache)
+        if (memcmp(e.Key, key, sizeof(key)) == 0)
+            return e.Shadow;
+    u32 sum[3] = {}, alpha = 0, shown = 0;
+    for (s32 t = t0; t < t1 && t < t0 + 256; t++)
+        for (s32 s = s0; s < s1 && s < s0 + 256; s++)
+        {
+            u16 c;
+            u8 a;
+            TextureLookup(gpu, p->TexParam, p->TexPalette, (s16)(s << 4), (s16)(t << 4), &c, &a);
+            if (a == 0)
+                continue;
+            for (int k = 0; k < 3; k++)
+                sum[k] += (c >> (5 * k)) & 0x1F;
+            alpha += a;
+            shown++;
+        }
+    bool shadow = false;
+    if (shown > 0)
+    {
+        const float r = sum[0] / (31.0f * shown), g = sum[1] / (31.0f * shown), b = sum[2] / (31.0f * shown);
+        const float hi = std::max({r, g, b}), lo = std::min({r, g, b});
+        const float lum = 0.25f * r + 0.625f * g + 0.125f * b;
+        const float opacity = (((p->Attr >> 16) & 0x1F) / 31.0f) * (alpha / (31.0f * shown));
+        shadow = lum < 0.45f && hi - lo <= std::max(0.3f * hi, 0.15f) && opacity < 0.8f;
+    }
+    ShadowCacheEntry e {};
+    memcpy(e.Key, key, sizeof(key));
+    e.Shadow = shadow;
+    ShadowCache.push_back(e);
+    return shadow;
+}
